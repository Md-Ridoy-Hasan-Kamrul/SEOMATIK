---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found" description="Page not found">
	<main id="main" class="grid min-h-dvh place-items-center px-4 text-center">
		<div>
			<h1 class="m-0 font-display text-2xl font-bold text-ink">404</h1>
			<p class="mt-2 m-0 text-ink-soft">This page does not exist.</p>
			<a href="/" class="mt-6 inline-block font-semibold text-sea no-underline hover:underline">
				Back home
			</a>
		</div>
	</main>
</Layout>
