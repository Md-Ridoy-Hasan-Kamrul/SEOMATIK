---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<div class="flex min-h-dvh flex-col">
		<header class="px-[clamp(1rem,4vw,2rem)] py-6">
			<p class="m-0 font-display text-lg font-bold tracking-tight text-ink">Seomatik</p>
		</header>

		<main
			id="main"
			class="mx-auto flex flex-1 w-[min(100%-2rem,40rem)] flex-col items-center justify-center px-4 pb-16 text-center motion-safe:[animation:rise_700ms_ease_both]"
		>
			<p class="m-0 font-mono text-xs uppercase tracking-[0.2em] text-sea">Astro + React</p>
			<h1 class="mt-4 m-0 font-display text-[clamp(2rem,8vw,3.25rem)] font-bold leading-[1.05] tracking-tight text-ink">
				Your animated site starts here
			</h1>
			<p class="mt-4 m-0 max-w-md text-pretty text-ink-soft">
				Clean slate. Add sections, motion, and React islands when you are ready.
			</p>
		</main>

		<footer class="px-[clamp(1rem,4vw,2rem)] py-6 text-center">
			<p class="m-0 text-sm text-ink-soft">© {new Date().getFullYear()} Seomatik</p>
		</footer>
	</div>
</Layout>
