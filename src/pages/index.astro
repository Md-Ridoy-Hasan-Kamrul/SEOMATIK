---
import HeroIntro from '../components/islands/hero/HeroIntro.tsx';
import Layout from '../layouts/Layout.astro';
---

<Layout title="SEOMATIK — Digital Growth. Engineered.">
	<HeroIntro client:load />

	<section
		id="technologie"
		class="mx-auto w-[min(100%-2rem,42rem)] px-4 pb-24 pt-20 text-center"
		aria-label="Next section placeholder"
	>
		<p class="m-0 font-mono text-xs uppercase tracking-[0.3em] text-ink-soft">
			Next section
		</p>
		<p class="mt-4 m-0 text-ink-soft">
			Build the following sections here. The intro hero lives in
			<code>src/components/islands/hero/</code>.
		</p>
	</section>
</Layout>
